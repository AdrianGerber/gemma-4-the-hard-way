{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Configure",
            "type": "shell",
            "command": "cmake -Bbuild .",
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "Build, Test and Run",
            "type": "shell",
            "command": "cmake --build build && ctest --test-dir build && ./build/hello_world",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
    ]
}